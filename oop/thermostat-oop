from microbit import *

class Thermostat:                       
    def __init__(self, room, degrees):
        self.room = room                 
        self.degrees = degrees          
    def scroll_temperature(self):         
        display.scroll(self.room)       
        display.scroll(self.degrees)

living_room = Thermostat("Living room", 21)
bathroom = Thermostat("Bathroom", 14)

while True:
    living_room.scroll_temperature()
    bathroom.scroll_temperature()
